{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope-audit-results",
  "title": "SCOPE Audit Results",
  "description": "Schema for audit phase results.json — validated by scope-schema-validate hook",
  "type": "object",
  "required": ["account_id", "source", "region", "timestamp", "summary", "graph", "attack_paths", "principals", "trust_relationships"],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "category": {
      "type": "string",
      "enum": ["privilege_escalation", "trust_misconfiguration", "data_exposure", "credential_risk", "excessive_permission", "network_exposure", "persistence", "post_exploitation", "lateral_movement"]
    },
    "evidenceRef": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["graph_edge", "module_resource", "policy_document", "runtime_assumption", "coverage_caveat"]
        },
        "id": { "$ref": "#/$defs/nullableNonEmptyString" },
        "source_path": { "$ref": "#/$defs/nullableNonEmptyString" },
        "arn": { "$ref": "#/$defs/nullableNonEmptyString" },
        "field": { "$ref": "#/$defs/nullableNonEmptyString" }
      },
      "anyOf": [
        { "required": ["id"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" } } },
        { "required": ["source_path"], "properties": { "source_path": { "$ref": "#/$defs/nonEmptyString" } } },
        { "required": ["arn"], "properties": { "arn": { "$ref": "#/$defs/nonEmptyString" } } }
      ],
      "additionalProperties": false
    },
    "attackContext": {
      "type": "object",
      "properties": {
        "principal": { "$ref": "#/$defs/nullableNonEmptyString" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    },
    "startingPosition": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["external", "principal", "resource", "public_endpoint"]
        },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "arn": { "$ref": "#/$defs/nullableNonEmptyString" }
      },
      "additionalProperties": false
    },
    "hop": {
      "type": "object",
      "required": ["id", "transition", "from_context", "action", "target", "resulting_context", "capability_gained", "required", "validation_type", "evidence", "assumptions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "transition": {
          "type": "string",
          "enum": ["invoke", "execute_as", "assume_role", "pass_role", "create_compute", "mutate_policy", "resource_policy_access", "data_access", "decrypt", "event_injection"]
        },
        "from_context": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "resulting_context": { "$ref": "#/$defs/nonEmptyString" },
        "capability_gained": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "validation_type": {
          "type": "string",
          "enum": ["graph", "iam", "resource_policy", "runtime_assumption", "coverage_caveat"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "assumptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "if": {
        "properties": {
          "validation_type": { "const": "runtime_assumption" }
        }
      },
      "then": {
        "properties": {
          "assumptions": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "evidence": { "minItems": 1 }
        }
      },
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "required": ["type", "resource", "action"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["admin_access", "data_access", "persistence", "lateral_movement", "exfiltration", "defense_evasion"]
        },
        "resource": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "publicEntrypoint": {
      "type": "object",
      "required": ["id", "service", "resource", "public_access", "auth_type", "starting_position", "attack_path_seed", "risk", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "service": { "$ref": "#/$defs/nonEmptyString" },
        "resource": { "$ref": "#/$defs/nonEmptyString" },
        "arn": { "$ref": "#/$defs/nullableNonEmptyString" },
        "public_access": { "type": "boolean" },
        "auth_type": {
          "type": "string",
          "enum": ["NONE", "IAM", "JWT", "COGNITO", "CUSTOM", "SAML", "OIDC", "RESOURCE_POLICY", "UNKNOWN"]
        },
        "starting_position": {
          "type": "string",
          "enum": ["external_unauthenticated", "external_authenticated", "external_cross_account", "external_unknown"]
        },
        "exposure_type": {
          "type": "string",
          "enum": ["public_endpoint", "public_resource_policy", "internet_facing_network", "external_identity_path", "public_data_surface", "unknown"]
        },
        "invokes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "execution_roles": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "reachable_resources": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "attack_path_seed": { "type": "boolean" },
        "seed_reason": { "$ref": "#/$defs/nonEmptyString" },
        "risk": { "$ref": "#/$defs/severity" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^\\d{12}$",
      "description": "12-digit AWS account ID"
    },
    "source": {
      "const": "audit"
    },
    "region": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "owned_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{12}$" },
          "name": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["severity"],
      "properties": {
        "total_users": { "type": "integer" },
        "total_roles": { "type": "integer" },
        "total_policies": { "type": "integer" },
        "total_trust_relationships": { "type": "integer" },
        "critical_priv_esc_risks": { "type": "integer" },
        "wildcard_trust_policies": { "type": "integer" },
        "cross_account_trusts": { "type": "integer" },
        "users_without_mfa": { "type": "integer" },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "services_analyzed": { "type": "integer" },
        "top_findings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths_by_category": {
          "type": "object",
          "properties": {
            "privilege_escalation": { "type": "integer" },
            "trust_misconfiguration": { "type": "integer" },
            "data_exposure": { "type": "integer" },
            "credential_risk": { "type": "integer" },
            "excessive_permission": { "type": "integer" },
            "network_exposure": { "type": "integer" },
            "persistence": { "type": "integer" },
            "post_exploitation": { "type": "integer" },
            "lateral_movement": { "type": "integer" }
          }
        },
        "reachability": {
          "type": "object",
          "description": "Aggregate reachability stats from Part 9 analysis — computed by attack path pipeline (domain sub-agents + synthesizer)",
          "properties": {
            "principals_with_admin_reach": { "type": "integer" },
            "principals_with_data_reach": { "type": "integer" },
            "max_blast_radius_principal": { "type": "string" },
            "max_blast_radius_nodes": { "type": "integer" },
            "avg_hop_count": { "type": "number" },
            "blocked_paths_total": { "type": "integer" }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["user", "role", "group", "escalation", "data", "external", "compute", "gateway", "messaging", "ai", "idp", "oidc"]
              },
              "resource_type": { "type": ["string", "null"] },
              "arn": { "type": ["string", "null"] },
              "service": { "type": "string" },
              "region": { "type": "string" },
              "account_id": { "type": "string" },
              "source_path": { "type": "string" },
              "_source": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "trust_type": { "type": "string" },
              "edge_type": {
                "type": "string",
                "enum": ["priv_esc", "trust", "data_access", "network", "service", "public_access", "cross_account", "membership", "executes_as", "invokes", "authenticates_to", "resource_policy_allows", "encrypted_by"]
              },
              "severity": { "type": "string" },
              "label": { "type": "string" },
              "id": { "type": "string" },
              "relationship": { "type": "string" },
              "service": { "type": "string" },
              "region": { "type": "string" },
              "account_id": { "type": "string" },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_path": { "type": "string" },
                    "resource_type": { "type": ["string", "null"] },
                    "resource_id": { "type": ["string", "null"] },
                    "arn": { "type": ["string", "null"] },
                    "field": { "type": "string" }
                  }
                }
              },
              "_source": { "type": "string" }
            }
          }
        }
      }
    },
    "public_entrypoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/publicEntrypoint" }
    },
    "attack_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_candidate_id", "validation_status", "name", "severity", "category", "description", "hops", "runtime_assumptions", "coverage_caveats"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "source_candidate_id": { "$ref": "#/$defs/nonEmptyString" },
          "validation_status": { "type": "string", "enum": ["validated", "conditional"] },
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "severity": { "$ref": "#/$defs/severity" },
          "category": { "$ref": "#/$defs/category" },
          "description": { "$ref": "#/$defs/nonEmptyString" },
          "hops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hop" } },
          "runtime_assumptions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "coverage_caveats": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "steps": { "type": "array", "items": { "type": "string" } },
          "mitre_techniques": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "detection_opportunities": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "remediation": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "affected_resources": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
        },
        "additionalProperties": false
      }
    },
    "candidate_attack_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "severity", "starting_position", "initial_context", "hops", "impact"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "category": { "$ref": "#/$defs/category" },
          "severity": { "$ref": "#/$defs/severity" },
          "starting_position": { "$ref": "#/$defs/startingPosition" },
          "initial_context": { "$ref": "#/$defs/attackContext" },
          "hops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hop" } },
          "impact": { "$ref": "#/$defs/impact" },
          "affected_resources": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "detection_opportunities": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "mitre_techniques": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "remediation": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
        },
        "additionalProperties": false
      }
    },
    "attack_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "status", "promotion_decision", "reason", "validated_hops", "conditional_hops", "failed_hops", "untested_hops", "runtime_assumptions", "coverage_caveats"],
        "properties": {
          "candidate_id": { "$ref": "#/$defs/nonEmptyString" },
          "status": { "type": "string", "enum": ["validated", "conditional", "rejected"] },
          "promotion_decision": { "type": "string", "enum": ["promote", "observe", "drop"] },
          "reason": { "$ref": "#/$defs/nonEmptyString" },
          "validated_hops": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "conditional_hops": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "failed_hops": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "untested_hops": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "runtime_assumptions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "coverage_caveats": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "final_context": { "$ref": "#/$defs/nullableNonEmptyString" },
          "validated_impact": {
            "anyOf": [
              { "$ref": "#/$defs/impact" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "security_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "reason_not_path"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "severity": { "$ref": "#/$defs/severity" },
          "description": { "$ref": "#/$defs/nonEmptyString" },
          "affected_resources": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
          "reason_not_path": { "$ref": "#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "arn"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["user", "role", "group"] },
          "arn": { "type": "string" },
          "reachability": {
            "type": "object",
            "description": "Part 9 reachability analysis — computed by attack path pipeline (domain sub-agents + synthesizer)",
            "properties": {
              "reachable_roles": { "type": "array", "items": { "type": "string" } },
              "reachable_data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "access_level": { "type": "string" }
                  }
                }
              },
              "max_privilege": { "type": "string", "enum": ["admin", "write", "read", "none"] },
              "hop_count": { "type": "integer" },
              "critical_paths": { "type": "array", "items": { "type": "object" } },
              "blocked_paths": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "trust_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role_id", "role_arn", "principal", "trust_type"],
        "properties": {
          "role_id": { "type": "string" },
          "role_arn": { "type": "string" },
          "principal": { "type": "string" },
          "trust_type": { "type": "string", "enum": ["same-account", "cross-account", "service", "wildcard", "federated"] },
          "is_wildcard": { "type": "boolean" },
          "has_external_id": { "type": "boolean" },
          "has_mfa_condition": { "type": "boolean" },
          "risk": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "is_internal": { "type": ["boolean", "null"] },
          "account_name": { "type": ["string", "null"] }
        }
      }
    }
  }
}
